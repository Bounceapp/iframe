{
  "name": "@bounceapp/iframe",
  "private": false,
  "license": "MIT",
  "description": "Iframe wrapper for React Native",
  "version": "0.4.0",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "react-native": "src/index",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index",
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "!lib/typescript/example",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/*.stories.@(js|jsx|ts|tsx)"
  ],
  "keywords": [
    "expo",
    "iframe",
    "react-native",
    "iframe-react-native",
    "ios",
    "android",
    "web"
  ],
  "repository": "https://github.com/Bounceapp/iframe",
  "author": "Bounce (https://usebounce.com)",
  "bugs": {
    "url": "https://github.com/Bounceapp/iframe/issues"
  },
  "homepage": "https://github.com/Bounceapp/iframe#readme",
  "scripts": {
    "test": "jest --passWithNoTests",
    "typecheck": "tsc",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "prepare": "bob build && lefthook install --reset-hooks-path",
    "release": "release-it",
    "build:docs": "storybook build --output-dir docs",
    "dev:docs": "storybook dev -p 6006",
    "example": "pnpm --dir example",
    "bootstrap": "pnpm example install && pnpm install"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.22.9",
    "@babel/preset-react": "^7.22.5",
    "@babel/preset-typescript": "^7.22.5",
    "@commitlint/cli": "17.8.1",
    "@commitlint/config-conventional": "17.8.1",
    "@release-it/conventional-changelog": "5.1.1",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-links": "10.6.7",
    "@storybook/react-native-web-vite": "10.6.7",
    "@types/jest": "28.1.8",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "expo": "58.0.23",
    "jest": "^29.2.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "0.44.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "release-it": "15.11.0",
    "storybook": "10.6.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-dom": "*",
    "react-native": "*",
    "react-native-web": "*",
    "react-native-webview": "*"
  },
  "packageManager": "pnpm@12.18.0"
}
