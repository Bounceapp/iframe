{
  "extends": "expo/tsconfig.base",
  "include": ["**/*", ".storybook/**/*"],
  // Build output, and the native projects `expo prebuild` generates.
  "exclude": ["lib", "docs", "example/ios", "example/android"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@bounceapp/iframe": ["./src/index"]
    },
    "types": ["jest"]
  }
}
