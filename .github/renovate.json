{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Lisbon",
  "labels": ["dependencies"],
  "postUpdateOptions": ["pnpmDedupe"],
  "baseBranches": ["main"],
  "lockFileMaintenance": {
    "enabled": false,
    "automerge": true
  },
  "major": {
    "dependencyDashboardApproval": true
  },
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true,
    "schedule": null,
    "stabilityDays": 0
  },
  "packageRules": [
    {
      "groupName": "manual",
      "matchPackageNames": [
        "react",
        "react-dom",
        "react-native",
        "react-native-web",
        "react-native-webview",
        "@types/react",
        "@types/react-dom",
        "expo"
      ],
      "enabled": false
    },
    {
      "groupName": "linting",
      "matchPackageNames": [
        "lefthook",
        "oxlint",
        "oxlint-tsgolint",
        "oxfmt",
        "@commitlint/cli",
        "@commitlint/config-conventional"
      ],
      "automerge": true
    },
    {
      "groupName": "storybook",
      "matchPackageNames": [
        "storybook",
        "@storybook/addon-docs",
        "@storybook/addon-links",
        "@storybook/addon-mcp",
        "@storybook/react-native-web-vite",
        "vite"
      ],
      "automerge": true
    },
    {
      "matchPackagePatterns": ["*"],
      "automerge": true
    }
  ]
}
